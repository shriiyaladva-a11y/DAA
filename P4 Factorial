//Recursion

int factorial(int n){
    if(n==0||n==1){
        return 1;
    }
    return n*factorial(n-1);
}
int main(){
    int num;
    cout<<"Enter a number:";
    cin>>num;
    cout<<"Factorial of number "<<num<<" is: "<<factorial(num)<<endl;
    return 0;
}
